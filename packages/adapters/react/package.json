{
    "name": "@finggu/react",
    "version": "0.9.0",
    "description": "FingguFlux React Adapter - Zero-runtime, high-performance headless UI components.",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "build": "tsc"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.*",
        "!src/**/__tests__"
    ],
    "dependencies": {
        "@finggu/core": "0.9.0",
        "@finggu/js-helper": "0.9.0"
    },
    "peerDependencies": {
        "react": ">=16.8.0",
        "react-dom": ">=16.8.0"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "typescript": "^5.0.0"
    }
}