{
    "name": "@finggu/svelte",
    "version": "0.9.0",
    "description": "Svelte adapter for FingguFlux UI library",
    "main": "dist/index.js",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "echo 'Svelte components do not require pre-build for this release'"
    },
    "files": [
        "dist",
        "src"
    ],
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        }
    },
    "dependencies": {
        "@finggu/core": "0.9.0",
        "@finggu/js-helper": "0.9.0"
    },
    "peerDependencies": {
        "svelte": ">=3.0.0"
    },
    "devDependencies": {
        "svelte": "^3.0.0",
        "typescript": "^5.0.0"
    }
}