{
    "name": "@finggujadhav/react",
    "version": "0.9.8",
    "description": "FingguFlux React Adapter - Zero-runtime, high-performance headless UI components.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.*",
        "!src/**/__tests__"
    ],
    "dependencies": {
        "@finggujadhav/core": "0.9.8",
        "@finggujadhav/js-helper": "0.9.8"
    },
    "peerDependencies": {
        "react": ">=16.8.0",
        "react-dom": ">=16.8.0"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "typescript": "^5.0.0"
    }
}